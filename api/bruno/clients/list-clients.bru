meta {
  name: List clients
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/clients?active_only=true
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response is an array", function() {
    expect(res.getBody()).to.be.an("array");
  });

  test("all clients belong to authenticated user", function() {
    const clients = res.getBody();
    clients.forEach(c => {
      expect(c.is_active).to.equal(true);
    });
  });
}
