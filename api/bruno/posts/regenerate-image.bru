meta {
  name: Regenerate image
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/posts/{{postId}}/regenerate-image
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "image_prompt_override": null
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("image_prompt is populated", function() {
    expect(res.getBody().image_prompt).to.be.a("string").and.not.empty;
  });

  test("version incremented", function() {
    expect(res.getBody().version).to.be.at.least(2);
  });
}
