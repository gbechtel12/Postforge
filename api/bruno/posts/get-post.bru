meta {
  name: Get post by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/posts/{{postId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("id matches postId", function() {
    expect(res.getBody().id).to.equal(bru.getEnvVar("postId"));
  });

  test("has caption", function() {
    expect(res.getBody()).to.have.property("caption");
    expect(res.getBody().caption).to.be.a("string").and.not.empty;
  });

  test("version is at least 1", function() {
    expect(res.getBody().version).to.be.at.least(1);
  });
}
